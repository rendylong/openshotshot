; npm migration note: this repo was migrated from bun (which installs despite
; unsatisfied peer ranges). The declared dependency set (e.g. vite@^8 with
; electron-vite@5, antd@^6 with @ant-design/pro-components@3.0.0-beta.3) relies
; on that leniency. legacy-peer-deps reproduces bun's behavior under npm.
legacy-peer-deps=true
