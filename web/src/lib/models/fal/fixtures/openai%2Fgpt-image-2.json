{
  "endpointId": "openai/gpt-image-2",
  "openapi": {
    "openapi": "3.0.4",
    "info": {
      "title": "Queue OpenAPI for fal-ai/gpt-image-2",
      "version": "1.0.0",
      "description": "The OpenAPI schema for the fal-ai/gpt-image-2 queue.",
      "x-fal-metadata": {
        "endpointId": "fal-ai/gpt-image-2",
        "category": "text-to-image",
        "thumbnailUrl": "https://v3b.fal.media/files/b/0a970be0/ePh1n5CD1PF3iC5Qgvy2s_902b7073383448d29be094688ae5448c.jpg",
        "playgroundUrl": "https://fal.ai/models/fal-ai/gpt-image-2",
        "documentationUrl": "https://fal.ai/models/fal-ai/gpt-image-2/api",
        "about": "GPT Image 2 is OpenAI's next-generation image generation model (alpha).\nIt supports flexible resolutions up to 4K and multiple model variants.\n\nUse it as a text-to-image API through fal!"
      }
    },
    "components": {
      "securitySchemes": {
        "apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "Authorization",
          "description": "Fal Key"
        }
      },
      "schemas": {
        "QueueStatus": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ]
            },
            "request_id": {
              "type": "string",
              "description": "The request id."
            },
            "response_url": {
              "type": "string",
              "description": "The response url."
            },
            "status_url": {
              "type": "string",
              "description": "The status url."
            },
            "cancel_url": {
              "type": "string",
              "description": "The cancel url."
            },
            "logs": {
              "type": "object",
              "description": "The logs.",
              "additionalProperties": true
            },
            "metrics": {
              "type": "object",
              "description": "The metrics.",
              "additionalProperties": true
            },
            "queue_position": {
              "type": "integer",
              "description": "The queue position."
            }
          },
          "required": [
            "status",
            "request_id"
          ]
        },
        "GptImage2Input": {
          "properties": {
            "num_images": {
              "title": "Number of Images",
              "minimum": 1,
              "type": "integer",
              "default": 1,
              "description": "Number of images to generate",
              "examples": [
                1
              ],
              "maximum": 4
            },
            "quality": {
              "title": "Quality",
              "enum": [
                "auto",
                "low",
                "medium",
                "high"
              ],
              "type": "string",
              "default": "high",
              "description": "Quality for the generated image. Use 'auto' to let the model pick the best quality for the prompt."
            },
            "sync_mode": {
              "title": "Sync Mode",
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "type": "boolean",
              "default": false
            },
            "background": {
              "title": "Background",
              "enum": [
                "auto",
                "transparent",
                "opaque"
              ],
              "type": "string",
              "default": "auto",
              "description": "Background for the generated image"
            },
            "output_format": {
              "title": "Output Format",
              "enum": [
                "jpeg",
                "png",
                "webp"
              ],
              "type": "string",
              "default": "png",
              "description": "Output format for the images"
            },
            "prompt": {
              "description": "The prompt for image generation",
              "examples": [
                "create a realistic image taken with iphone at these coordinates 41°43′32″N 49°56′49″W 15 April 1912"
              ],
              "type": "string",
              "minLength": 2,
              "title": "Prompt",
              "maxLength": 32000
            },
            "image_size": {
              "title": "Image Size",
              "description": "The size of the generated image. Supports preset names, explicit {width, height}, or 'auto' to let the model pick the best size. Concrete sizes must have both dimensions as multiples of 16, max edge 3840px, aspect ratio <= 3:1, total pixels between 655,360 and 8,294,400.",
              "default": "landscape_4_3",
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9",
                    "auto"
                  ],
                  "type": "string"
                }
              ]
            }
          },
          "title": "TextToImageRequest",
          "type": "object",
          "required": [
            "prompt"
          ],
          "x-fal-order-properties": [
            "prompt",
            "image_size",
            "background",
            "quality",
            "num_images",
            "output_format",
            "sync_mode"
          ]
        },
        "GptImage2Output": {
          "properties": {
            "images": {
              "title": "Images",
              "examples": [
                [
                  {
                    "width": 1024,
                    "content_type": "image/png",
                    "height": 1024,
                    "url": "https://v3b.fal.media/files/b/0a869129/EnWrO3XWjPE0nxBDpaQrj.png",
                    "file_name": "EnWrO3XWjPE0nxBDpaQrj.png"
                  }
                ]
              ],
              "type": "array",
              "description": "The generated images.",
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              }
            }
          },
          "title": "ImageResponse",
          "type": "object",
          "required": [
            "images"
          ],
          "x-fal-order-properties": [
            "images"
          ]
        },
        "ImageSize": {
          "properties": {
            "width": {
              "title": "Width",
              "description": "The width of the generated image.",
              "type": "integer",
              "default": 512,
              "maximum": 14142,
              "exclusiveMinimum": 0
            },
            "height": {
              "title": "Height",
              "description": "The height of the generated image.",
              "type": "integer",
              "default": 512,
              "maximum": 14142,
              "exclusiveMinimum": 0
            }
          },
          "title": "ImageSize",
          "type": "object",
          "x-fal-order-properties": [
            "width",
            "height"
          ]
        },
        "ImageFile": {
          "properties": {
            "width": {
              "title": "Width",
              "description": "The width of the image",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content_type": {
              "examples": [
                "image/png"
              ],
              "title": "Content Type",
              "description": "The mime type of the file.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "title": "Height",
              "description": "The height of the image",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "title": "Url",
              "description": "The URL where the file can be downloaded from.",
              "type": "string"
            },
            "file_size": {
              "examples": [
                4404019
              ],
              "title": "File Size",
              "description": "The size of the file in bytes.",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_name": {
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "title": "File Name",
              "description": "The name of the file. It will be auto-generated if not provided.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "ImageFile",
          "type": "object",
          "required": [
            "url"
          ],
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        }
      }
    },
    "paths": {
      "/fal-ai/gpt-image-2/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            },
            {
              "name": "logs",
              "in": "query",
              "required": false,
              "schema": {
                "type": "number",
                "description": "Whether to include logs (`1`) in the response or not (`0`)."
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The request status.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/gpt-image-2/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The request was cancelled.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "description": "Whether the request was cancelled successfully."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/gpt-image-2": {
        "post": {
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GptImage2Input"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The request status.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/gpt-image-2/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Result of the request.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GptImage2Output"
                  }
                }
              }
            }
          }
        }
      }
    },
    "servers": [
      {
        "url": "https://queue.fal.run"
      }
    ],
    "security": [
      {
        "apiKeyAuth": []
      }
    ]
  }
}
