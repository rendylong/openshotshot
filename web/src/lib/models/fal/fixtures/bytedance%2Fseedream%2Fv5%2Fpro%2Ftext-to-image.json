{
  "endpointId": "bytedance/seedream/v5/pro/text-to-image",
  "openapi": {
    "openapi": "3.0.4",
    "info": {
      "title": "Queue OpenAPI for fal-ai/seedream-5-pro/text-to-image",
      "version": "1.0.0",
      "description": "The OpenAPI schema for the fal-ai/seedream-5-pro/text-to-image queue.",
      "x-fal-metadata": {
        "endpointId": "fal-ai/seedream-5-pro/text-to-image",
        "playgroundUrl": "https://fal.ai/models/fal-ai/seedream-5-pro/text-to-image",
        "documentationUrl": "https://fal.ai/models/fal-ai/seedream-5-pro/text-to-image/api",
        "about": "Generate images using Bytedance's Seedream 5.0 Pro model."
      }
    },
    "components": {
      "securitySchemes": {
        "apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "Authorization",
          "description": "Fal Key"
        }
      },
      "schemas": {
        "QueueStatus": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ]
            },
            "request_id": {
              "type": "string",
              "description": "The request id."
            },
            "response_url": {
              "type": "string",
              "description": "The response url."
            },
            "status_url": {
              "type": "string",
              "description": "The status url."
            },
            "cancel_url": {
              "type": "string",
              "description": "The cancel url."
            },
            "logs": {
              "type": "object",
              "description": "The logs.",
              "additionalProperties": true
            },
            "metrics": {
              "type": "object",
              "description": "The metrics.",
              "additionalProperties": true
            },
            "queue_position": {
              "type": "integer",
              "description": "The queue position."
            }
          },
          "required": [
            "status",
            "request_id"
          ]
        },
        "Seedream5ProTextToImageInput": {
          "title": "SeedDream50ProT2IInput",
          "properties": {
            "output_format": {
              "title": "Output Format",
              "default": "jpeg",
              "type": "string",
              "description": "The file format of the generated image.",
              "examples": [
                "jpeg"
              ],
              "enum": [
                "jpeg",
                "png"
              ]
            },
            "sync_mode": {
              "title": "Sync Mode",
              "type": "boolean",
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "default": false
            },
            "prompt": {
              "title": "Prompt",
              "type": "string",
              "description": "The text prompt used to generate the image.",
              "examples": [
                "Vibrant editorial of a model in contemporary fashion fused with West African textile patterns and beadwork, Campbell Addy bold aesthetic, saturated palette, dramatic studio lighting, celebratory cultural richness, striking contemporary portraiture"
              ]
            },
            "enable_safety_checker": {
              "title": "Enable Safety Checker",
              "type": "boolean",
              "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
              "examples": [
                true
              ],
              "default": true
            },
            "num_images": {
              "maximum": 6,
              "title": "Num Images",
              "minimum": 1,
              "type": "integer",
              "description": "Number of separate model generations to run with the prompt.",
              "default": 1
            },
            "image_size": {
              "title": "Image Size",
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "type": "string",
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9",
                    "auto_1K",
                    "auto_2K"
                  ]
                }
              ],
              "examples": [
                "auto_2K"
              ],
              "description": "The size of the generated image. Total pixels must be between 1024x1024 and 2048x2048, with aspect ratio between 1/16 and 16.",
              "x-fal": {
                "max_area": 4194304,
                "max_aspect_ratio": 16,
                "min_aspect_ratio": 0.0625,
                "min_area": 1048576
              },
              "default": "auto_2K"
            }
          },
          "x-fal-order-properties": [
            "prompt",
            "image_size",
            "num_images",
            "output_format",
            "sync_mode",
            "enable_safety_checker"
          ],
          "type": "object",
          "required": [
            "prompt"
          ]
        },
        "Seedream5ProTextToImageOutput": {
          "title": "SeedDream50ProT2IOutput",
          "properties": {
            "images": {
              "title": "Images",
              "type": "array",
              "description": "Generated images.",
              "examples": [
                [
                  {
                    "url": "https://v3b.fal.media/files/b/0aa16df4/ktjX_-2KKAw7bCTQgopGV_5b49dc459dfe484fbb1218fce0e24bc7.png"
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/Image"
              }
            }
          },
          "x-fal-order-properties": [
            "images"
          ],
          "type": "object",
          "required": [
            "images"
          ]
        },
        "ImageSize": {
          "title": "ImageSize",
          "properties": {
            "width": {
              "maximum": 14142,
              "title": "Width",
              "type": "integer",
              "description": "The width of the generated image.",
              "default": 512,
              "exclusiveMinimum": 0
            },
            "height": {
              "maximum": 14142,
              "title": "Height",
              "type": "integer",
              "description": "The height of the generated image.",
              "default": 512,
              "exclusiveMinimum": 0
            }
          },
          "type": "object",
          "x-fal-order-properties": [
            "width",
            "height"
          ]
        },
        "Image": {
          "title": "Image",
          "properties": {
            "width": {
              "title": "Width",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                1024
              ],
              "description": "The width of the image in pixels."
            },
            "url": {
              "title": "Url",
              "type": "string",
              "description": "The URL where the file can be downloaded from."
            },
            "content_type": {
              "title": "Content Type",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "image/png"
              ],
              "description": "The mime type of the file."
            },
            "file_name": {
              "title": "File Name",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "description": "The name of the file. It will be auto-generated if not provided."
            },
            "height": {
              "title": "Height",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                1024
              ],
              "description": "The height of the image in pixels."
            },
            "file_size": {
              "title": "File Size",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                4404019
              ],
              "description": "The size of the file in bytes."
            }
          },
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ],
          "type": "object",
          "description": "Represents an image file.",
          "required": [
            "url"
          ]
        }
      }
    },
    "paths": {
      "/fal-ai/seedream-5-pro/text-to-image/requests/{request_id}/status": {
        "get": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            },
            {
              "name": "logs",
              "in": "query",
              "required": false,
              "schema": {
                "type": "number",
                "description": "Whether to include logs (`1`) in the response or not (`0`)."
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The request status.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/seedream-5-pro/text-to-image/requests/{request_id}/cancel": {
        "put": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The request was cancelled.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "description": "Whether the request was cancelled successfully."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/seedream-5-pro/text-to-image": {
        "post": {
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Seedream5ProTextToImageInput"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The request status.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/QueueStatus"
                  }
                }
              }
            }
          }
        }
      },
      "/fal-ai/seedream-5-pro/text-to-image/requests/{request_id}": {
        "get": {
          "parameters": [
            {
              "name": "request_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "description": "Request ID"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Result of the request.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Seedream5ProTextToImageOutput"
                  }
                }
              }
            }
          }
        }
      }
    },
    "servers": [
      {
        "url": "https://queue.fal.run"
      }
    ],
    "security": [
      {
        "apiKeyAuth": []
      }
    ]
  }
}
